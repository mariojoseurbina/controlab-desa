// 1. Catálogo de Almacenes/Sucursales
model Almacen {
  id                  Int                 @id @default(autoincrement())
  nombre              String              @db.NVarChar(100)
  descripcion         String?             @db.NVarChar(255)
  activo              Boolean             @default(true)
  fecha_creacion      DateTime            @default(now())
  stock_sucursales    StockPorAlmacen[]
  
  // Relaciones
  movimientos         MovimientoInventario[] @relation("AlmacenMovimiento")
  transferencias_env  MovimientoInventario[] @relation("AlmacenOrigen")

  @@map("almacenes")
}

// 2. Stock por Ubicación
model StockPorAlmacen {
  id             Int            @id @default(autoincrement())
  item_id        Int
  almacen_id     Int
  stock_actual   Decimal        @default(0.00) @db.Decimal(10, 2)
  ubicacion      String?        @db.NVarChar(100)
  
  item           ItemInventario @relation(fields: [item_id], references: [id], onDelete: Cascade)
  almacen        Almacen        @relation(fields: [almacen_id], references: [id], onDelete: Cascade)

  // Búsqueda instantánea de stock por producto en sucursal (VPN-Safe)
  @@unique([item_id, almacen_id], map: "UQ_stock_item_almacen")
  @@map("stock_por_almacen")
}

// ---------------------------------------------------------
// SISTEMA DE TRAZABILIDAD (AUDIT LOG)
// ---------------------------------------------------------
model RegistroTrazabilidad {
  id              Int      @id @default(autoincrement())
  usuario_id      Int
  accion          String   @db.NVarChar(100) // EJ: CREAR, EDITAR, ELIMINAR, ABRIR
  entidad         String   @db.NVarChar(100) // EJ: LOTE, ITEM, MOVIMIENTO
  entidad_id      Int?
  detalles_json   String?  @db.NVarChar(Max)
  direccion_ip    String?  @db.NVarChar(50)
  fecha_registro  DateTime @default(now()) @db.DateTime

  // Relación opcional con usuarios (No action on delete para que no borre historial)
  usuario         usuarios @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id], map: "IX_Trazabilidad_Usuario")
  @@index([entidad, entidad_id], map: "IX_Trazabilidad_Entidad")
  @@index([fecha_registro], map: "IX_Trazabilidad_Fecha")
  
  @@map("registro_trazabilidad")
}
