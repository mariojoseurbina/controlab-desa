// ConfiguraciÃ³n de Costos Operativos Globales Mensuales
model GastoMensualGlobal {
  id                   Int      @id @default(autoincrement())
  mes                  Int      // 1-12
  anio                 Int      // AÃ±o
  gastos_administrativos Decimal  @db.Decimal(18, 2)
  gastos_personal       Decimal  @db.Decimal(18, 2)
  total_pruebas_mes     Int      
  desglose_admin       String?  @db.NVarChar(Max)
  fecha_registro       DateTime @default(now())
  
  @@unique([mes, anio])
  @@map("gastos_mensual_global")
}

// ConfiguraciÃ³n de Soluciones y Calibradores por Equipo/Ã rea
model CostoEquipoSolucion {
  id                  Int      @id @default(autoincrement())
  nombre_equipo       String   @db.NVarChar(100)
  gasto_soluciones    Decimal  @db.Decimal(18, 2)
  gasto_calibradores  Decimal  @db.Decimal(18, 2)
  gasto_controles     Decimal  @db.Decimal(18, 2)
  total_pruebas_equipo Int      
  configs             CostoPruebaConfig[]
  
  @@map("costo_equipo_solucion")
}

// ConfiguraciÃ³n especÃ­fica de costos unitarios de una prueba
model CostoPruebaConfig {
  id                 Int                  @id @default(autoincrement())
  prueba_id          Int                  @unique
  precio_venta       Decimal              @db.Decimal(18, 2)
  desperdicio_pct    Decimal              @default(5.00) @db.Decimal(5, 2)
  pruebas_por_kit    Int                  
  reactivo_id        Int                  
  equipo_id          Int?
  equipo             CostoEquipoSolucion? @relation(fields: [equipo_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  consumibles        ConsumiblePrueba[]
  prueba             pruebas_maestra      @relation(fields: [prueba_id], references: [id], onDelete: Cascade)
  
  @@map("costo_prueba_config")
}

// Consumibles detallados vinculados a una prueba genÃ©rica
model ConsumiblePrueba {
  id                 Int                @id @default(autoincrement())
  costo_config_id    Int
  item_id            Int                
  cantidad           Decimal            @db.Decimal(10, 2)
  fase               String             @db.NVarChar(50)   // "TOMA_MUESTRA" o "PROCESAMIENTO"
  costo_config       CostoPruebaConfig  @relation(fields: [costo_config_id], references: [id], onDelete: Cascade)
  item               ItemInventario     @relation(fields: [item_id], references: [id])
  
  @@map("consumible_prueba")
}

// Volumen de pruebas procesadas por Ã¡rea en un mes especÃ­fico
model VolumenAreaMensual {
  id        Int      @id @default(autoincrement())
  mes       Int      // 1-12
  anio      Int      // AÃ±o
  area      String   @db.NVarChar(100)
  volumen   Int      // NÃºmero de pruebas del Ã¡rea en el mes
  
  @@unique([mes, anio, area], name: "mes_anio_area")
  @@map("volumen_area_mensual")
}


