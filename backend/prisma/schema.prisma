generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model ItemInventario {
  id                  Int              @id(map: "PK__items_in__3213E83F2F9A3526") @default(autoincrement())
  codigo              String           @unique(map: "UQ__items_in__40F9A206FF1A9DC8") @db.NVarChar(50)
  nombre              String           @db.NVarChar(100)
  descripcion         String?          @db.NVarChar(500)
  categoria           String           @db.NVarChar(50)
  unidad              String           @db.NVarChar(20)
  stock_actual        Decimal?         @default(0, map: "DF__items_inv__stock__1920BF5C") @db.Decimal(10, 2)
  stock_minimo        Decimal?         @default(0, map: "DF__items_inv__stock__1A14E395") @db.Decimal(10, 2)
  stock_maximo        Decimal?         @default(0, map: "DF__items_inv__stock__1B0907CE") @db.Decimal(10, 2)
  stock_critico       Decimal?         @default(0, map: "DF__items_inv__stock__1BFD2C07") @db.Decimal(10, 2)
  proveedor           String?          @db.NVarChar(100)
  precio_costo        Decimal?         @db.Decimal(10, 2)
  precio_venta        Decimal?         @db.Decimal(10, 2)
  ubicacion           String?          @db.NVarChar(50)
  fecha_vencimiento   DateTime?        @db.Date
  activo              Boolean?         @default(true, map: "DF__items_inv__activ__1CF15040")
  creado_por          Int?
  fecha_creacion      DateTime?        @default(now(), map: "DF__items_inv__fecha__1ED998B2")
  fecha_actualizacion DateTime?        @default(now(), map: "DF__items_inv__fecha__1FCDBCEB") @updatedAt
  area_operativa      String?          @db.NVarChar(100)
  naturaleza          String?          @db.NVarChar(50)
  regimen_fiscal      String?          @default("EXENTO") @db.NVarChar(50)
  porcentaje_impuesto_especial Decimal? @default(0.00) @db.Decimal(5, 2)
  estado_calidad      String?          @default("ACTIVO") @db.NVarChar(50)
  nota_desincorporacion String?        @db.NVarChar(500)
  marca               String?          @db.NVarChar(100)
  codigo_barra        String?          @db.NVarChar(100)
  referencia          String?          @db.NVarChar(50)
  grupo               String?          @db.NVarChar(50)
  panel               String?          @db.NVarChar(100)
  control_asociado    String?          @db.NVarChar(100)
  calibradores_asociados String?       @db.NVarChar(200)
  unidad_manejo       String?          @db.NVarChar(20)
  cantidad_unidades   Decimal?         @default(1) @db.Decimal(10, 2)
  unidad_test         Decimal?         @default(180) @db.Decimal(10, 2)
  costo_unitario_manejo Decimal?       @db.Decimal(10, 4)
  aplica_iva          Boolean?         @default(false)
  porcentaje_utilidad Decimal?         @db.Decimal(5, 2)
  stock_promedio      Decimal?         @default(0) @db.Decimal(10, 2)
  unidad_negocio      String?          @db.NVarChar(100)
  equipo_asociado     String?          @db.NVarChar(100)
  consumo_indicado    Decimal?         @db.Decimal(10, 4)
  consumo_real        Decimal?         @db.Decimal(10, 4)
  desviacion_consumo  Decimal?         @db.Decimal(5, 2)
  usuarios            usuarios?        @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__items_inv__cread__1DE57479")
  stock_sucursales    StockPorAlmacen[]
  LotesReactivos      LotesReactivos[]
  reactivos           reactivos[]
  vinculos            vinculo_prueba_item[]
  consumibles         ConsumiblePrueba[]

  @@map("items_inventario")
}

model MovimientoInventario {
  id               Int       @id(map: "PK__movimien__3213E83F39FAF8EC") @default(autoincrement())
  item_id          Int
  tipo_movimiento  String    @db.VarChar(20)
  cantidad         Decimal   @db.Decimal(10, 2)
  stock_anterior   Decimal   @db.Decimal(10, 2)
  stock_nuevo      Decimal   @db.Decimal(10, 2)
  motivo           String?   @db.VarChar(255)
  referencia       String?   @db.VarChar(100)
  fecha_movimiento DateTime? @default(now(), map: "DF__movimient__fecha__39E294A9") @db.DateTime
  creado_por       Int?      @default(1, map: "DF__movimient__cread__3AD6B8E2")
  
  // Multi-Almacén fields
  almacen_id          Int?      
  almacen_destino_id  Int?      

  almacen             Almacen?  @relation("AlmacenMovimiento", fields: [almacen_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  almacen_destino     Almacen?  @relation("AlmacenOrigen", fields: [almacen_destino_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Performance Indexes for high latency VPNs
  @@index([almacen_id], map: "IX_movimientos_almacen")
  @@index([item_id], map: "IX_movimientos_item")
  @@index([fecha_movimiento], map: "IX_movimientos_fecha")
  @@map("movimientos_inventario")
}

